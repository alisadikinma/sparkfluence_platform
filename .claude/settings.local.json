{
  "permissions": {
    "allow": [
      "Bash(tree:*)",
      "Bash(dir:*)",
      "Bash(node:*)",
      "Bash(node -e:*)",
      "Bash(findstr:*)",
      "Bash(find:*)",
      "Bash(cd:*)",
      "Bash(echo:*)",
      "Bash(curl:*)",
      "Bash(test:*)",
      "Bash(python:*)",
      "Bash(pushd:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npx tsc:*)",
      "Bash(npx deno:*)",
      "Bash(npx vite build:*)",
      "Bash(npx supabase:*)",
      "Bash(npx -p typescript tsc:*)",
      "Bash(supabase functions:*)",
      "Bash(supabase functions deploy:*)",
      "Bash(supabase functions logs:*)",
      "Bash(supabase secrets:*)",
      "Bash(supabase secrets set:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh api:*)",
      "Bash(gh repo view:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(claude:*)",
      "Bash(timeout /t 5)",
      "Bash(mkdir:*)",
      "mcp__ssh-prod-vps__exec",
      "mcp__supabase__execute_sql",
      "mcp__mcp-registry__search_mcp_registry",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:obra.github.io)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:composio.dev)",
      "WebFetch(domain:medium.com)",
      "WebFetch(domain:mcpservers.org)",
      "WebFetch(domain:www.remotion.dev)",
      "WebFetch(domain:skillsmp.com)",
      "WebFetch(domain:claude.com)",
      "mcp__github__get_file_contents"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "supabase",
    "context7",
    "github"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-env-edit.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/block-lockfile-edit.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/type-check-on-edit.js"
          }
        ]
      }
    ]
  }
}
